# Native: dsm --config /absolute/settings.env init /absolute/new-instance
# For Docker pass supported values as environment; never source this file as shell.
MODEL=DS223
# Optional user-supplied serial: init only; on run this is a read-only identity assertion.
# Leave blank to create without a serial. Never commit a real device identifier.
SERIAL=
EXPERIMENTAL_DS423=N
DISK_SIZE=32G
DISK_FMT=qcow2
ALLOCATE=N
CPU_CORES=4
RAM_SIZE=2G
RAM_CHECK=Y
HTTP_PORT=15504
SMB_PORT=14445
USER_PORTS=
MAC=
NETWORK=user
BIND_ADDRESS=127.0.0.1
ACCEL=hvf
DEBUG=N
STARTUP_TIMEOUT=600
TIMEOUT=105
SHUTDOWN=N
SHUTDOWN_CREDENTIALS=
STORAGE=
PAT_FILE=
URL=
